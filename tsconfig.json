{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "lib": [
      "ESNext",
      "ESNext.AsyncIterable",
      "DOM",
      "DOM.Iterable",
    ],
    "esModuleInterop": true,
    "allowJs": true,
    "sourceMap": true,
    "strict": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@pkg/*": [
        "./pkg/rancher-desktop/*"
      ],
      "@rdd-client": [
        "./pkg/rdd-client/index"
      ],
      "@shell/*": [
        "./node_modules/@rancher/shell/*"
      ]
    },
    "typeRoots": [
      "./node_modules",
      "./node_modules/@types",
      "./node_modules/@rancher/shell/types"
    ],
    "types": [
      "@types/node",
      "@types/jest"
    ]
  },
  "exclude": [
    "node_modules",
    "dist",
    "dashboard"
  ],
  "include": [
    "**/*",
    "**/*.ts",
    "**/*.d.ts",
    "**/*.vue",
    ".eslintrc.js"
  ]
}
